# Copy this file to .env and fill in real values. Never commit the real .env.

# Django
SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
RENDER_EXTERNAL_HOSTNAME=
SECURE_SSL_REDIRECT=

# Supabase-backed Postgres database (used by apps in config/routers.py::SUPABASE_APPS)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Supabase Storage (used by pipelines genome_upload management command)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Local GenBank file ingestion root (optional; falls back to BASE_DIR/parent dir detection)
GENBANK_ROOT=
